{
  "session-tracker": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ./hook-adapter.sh pre-invocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hook-adapter.sh pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hook-adapter.sh post-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash ./hook-adapter.sh stop",
        "timeout": 5
      }
    ]
  }
}
